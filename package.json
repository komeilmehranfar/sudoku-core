{
  "name": "sudoku-core",
  "version": "4.1.1",
  "description": "Human-logic Sudoku engine for TypeScript: generate unique puzzles across 10 difficulty levels, solve step by step with 31 named techniques, rate difficulty, and teach hints. Zero dependencies.",
  "keywords": [
    "sudoku",
    "sudoku-generator",
    "sudoku-solver",
    "sudoku-hint",
    "sudoku-rating",
    "human-solver",
    "x-wing",
    "swordfish",
    "y-wing",
    "puzzle",
    "generator",
    "solver",
    "typescript"
  ],
  "homepage": "https://github.com/komeilmehranfar/sudoku-core#readme",
  "bugs": {
    "url": "https://github.com/komeilmehranfar/sudoku-core/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/komeilmehranfar/sudoku-core.git"
  },
  "license": "MIT",
  "author": "Komeil Mehranfar <komeil.mehranfar@gmail.com>",
  "sideEffects": false,
  "type": "commonjs",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "prepare": "node -e \"try{require('husky').install()}catch(e){}\"",
    "build": "tsup",
    "test": "jest --runInBand",
    "test:cov": "jest --coverage --runInBand",
    "lint": "eslint src tests --ext .ts",
    "lint:fix": "eslint src tests --ext .ts --fix",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.test.json",
    "check:package": "publint --strict && attw --pack . --profile node16",
    "size": "size-limit",
    "docs": "typedoc",
    "prepublishOnly": "npm run build"
  },
  "lint-staged": {
    "*.ts": [
      "eslint --fix"
    ],
    "*.{json,md,yml,yaml}": [
      "prettier --write"
    ]
  },
  "size-limit": [
    {
      "name": "ESM, full API",
      "path": "dist/index.mjs",
      "limit": "15 kB"
    },
    {
      "name": "ESM, generate + solve",
      "path": "dist/index.mjs",
      "import": "{ generate, solve }",
      "limit": "12 kB"
    },
    {
      "name": "CJS",
      "path": "dist/index.cjs",
      "limit": "15 kB"
    }
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@size-limit/preset-small-lib": "^14.2.0",
    "@types/jest": "^29.5.10",
    "@typescript-eslint/eslint-plugin": "^8.72.0",
    "@typescript-eslint/parser": "^6.13.1",
    "eslint": "^8.55.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.7",
    "husky": "^9.1.7",
    "jest": "^29.7.0",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10",
    "publint": "^0.3.25",
    "size-limit": "^14.2.0",
    "ts-jest": "^29.4.15",
    "tsup": "^8.5.1",
    "typedoc": "^0.28.20",
    "typescript": "^5.3.2"
  }
}
